# --- Domain & Network ---
# Public domain routed via cloudflared -> http://127.0.0.1:8000
APP_DOMAIN=sniper.hodgman.net
APP_ORIGIN=https://sniper.hodgman.net
HOST_BIND=127.0.0.1
HOST_PORT=8000

# --- Bootstrap Admin Account (optional; if unset, configure via first-visit UI) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Security & VAPID Web Push ---
# Leave blank to auto-generate and persist securely in ./data on first boot
SESSION_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sniper.hodgman.net

# --- Discord Notifications ---
# Create one webhook in your shared #class-alerts channel and paste the URL here
DISCORD_SHARED_WEBHOOK_URL=

# --- Poller & Rate Limiting ---
# Cornell asks API consumers to keep requests <= 1 req/s
POLL_MAX_RPS=0.9
CORNELL_API_TIMEOUT_SEC=8.0
CATALOG_SYNC_INTERVAL_HOURS=12
MAX_SUBJECTS_PER_INVITED_USER=8
ALLOW_CUSTOM_PERSONAL_WEBHOOKS=true
